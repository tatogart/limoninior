# --- обязательно в продакшене ---
NODE_ENV=production
# Публичный адрес мессенджера (тот же, что откроется в браузере)
APP_ORIGIN=https://chat.example.ru
# OAuth Client ID из Google Cloud Console (тип «Веб-приложение»)
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# --- админка (если не заполнено — админка полностью выключена) ---
# Ваш Google-email (можно несколько через запятую)
ADMIN_EMAILS=you@gmail.com
# Секрет для кода из приложения-аутентификатора: npm run admin:totp -- you@gmail.com
ADMIN_TOTP_SECRET=
# Необязательно: пускать в админку только с этих IP (через запятую)
ADMIN_IPS=
# Сколько минут действует разблокировка админки
ADMIN_SESSION_MINUTES=15

# --- прочее ---
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
SESSION_DAYS=60
# Сколько прокси перед приложением (Caddy/nginx = 1)
TRUST_PROXY=1
