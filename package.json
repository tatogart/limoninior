{
  "name": "limoninior",
  "version": "1.0.0",
  "private": true,
  "description": "Limoninior — быстрый и красивый мессенджер (PWA)",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "NODE_ENV=development DEV_LOGIN=1 node --disable-warning=ExperimentalWarning --watch server/index.js",
    "admin:totp": "node scripts/admin-totp.js",
    "check": "node --check server/*.js && node --check public/js/*.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  }
}
